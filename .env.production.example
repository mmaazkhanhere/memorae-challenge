# Production configuration template.
# Keep this separate from the local .env file and replace the placeholders
# before starting the production API, worker, or migration command.
# The production deployment should receive these values from its secret store
# (for example, Railway variables) rather than committing a .env.production file.

# Neon PostgreSQL. Keep sslmode=require in the Neon connection string.
DATABASE_URL=postgresql+psycopg://replace-with-neon-user:replace-with-neon-password@replace-with-neon-host/replace-with-neon-database?sslmode=require

# Never point integration-test cleanup at the production database.
# Set TEST_DATABASE_URL only in the dedicated test environment.
TEST_DATABASE_URL=
