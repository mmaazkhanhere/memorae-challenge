DATABASE_URL=postgresql+psycopg://memorae:memorae@localhost:5433/memorae
# Optional PostgreSQL integration-test database. Never point this at DATABASE_URL.
TEST_DATABASE_URL=postgresql+psycopg://memorae:memorae@localhost:5434/memorae_test
# Replace with the real Telegram bot token before deployment.
TELEGRAM_BOT_TOKEN=replace-with-bot-token
# Replace with a unique random value of at least 32 characters before deployment.
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
VAPI_ENABLED=false
# Configure when VAPI_ENABLED=true. Use the saved Bearer credential configured
# on the Vapi phone-number/org Server URL; never commit the real value.
VAPI_WEBHOOK_BEARER_TOKEN=replace-with-vapi-token
VAPI_CALL_AUTHORIZATION_TTL_SECONDS=3600
VAPI_ASSISTANT_NAME=Memorae
VAPI_ASSISTANT_FIRST_MESSAGE=Hi, you're connected to Memorae. How can I help?
VAPI_ASSISTANT_SYSTEM_PROMPT=You are Memorae's voice assistant. Use the matching server tool for reminder and memory requests, pass the caller's complete utterance, and wait for its committed result before confirming.
VAPI_MODEL_PROVIDER=openai
VAPI_MODEL=gpt-4o-mini
VAPI_VOICE_PROVIDER=11labs
VAPI_VOICE_ID=sarah
VAPI_FIRST_MESSAGE_INTERRUPTIONS_ENABLED=true
VAPI_STOP_SPEAKING_NUM_WORDS=0
VAPI_STOP_SPEAKING_VOICE_SECONDS=0.2
VAPI_STOP_SPEAKING_BACKOFF_SECONDS=1.0
TELEGRAM_API_TIMEOUT_SECONDS=10
TELEGRAM_VOICE_MAX_BYTES=20971520
TELEGRAM_VOICE_MAX_DURATION_SECONDS=300
TELEGRAM_VOICE_LOG_TRANSCRIPT=false
TELEGRAM_CONFIRMATION_MAX_ATTEMPTS=3
TELEGRAM_CONFIRMATION_RETRY_DELAY_SECONDS=0.25
TELEGRAM_CONFIRMATION_BACKGROUND_MAX_ATTEMPTS=3
TELEGRAM_CONFIRMATION_BACKGROUND_RETRY_BASE_DELAY_SECONDS=30
# Scheduler worker polling and delivery policy.
WORKER_POLL_INTERVAL_SECONDS=5
WORKER_CLAIM_LEASE_SECONDS=60
# Wait briefly past a due time before claiming delivery, allowing near-deadline
# reschedule requests to finish their validated transaction.
WORKER_DELIVERY_GRACE_SECONDS=15
RECURRENCE_MATERIALIZATION_HORIZON_DAYS=35
RECURRENCE_MATERIALIZATION_BATCH_SIZE=100
NOTIFICATION_RETRY_MAX_ATTEMPTS=3
NOTIFICATION_UNCERTAIN_MAX_RETRIES=2
NOTIFICATION_RETRY_BASE_DELAY_SECONDS=30
# OpenAI-compatible structured intent endpoint. Leave this as-is for OpenAI;
# override it for Groq, a Gemini-compatible gateway, or a local endpoint.
LLM_BASE_URL=https://api.openai.com/v1
# Required for production startup. Local/test apps with injected sessions may leave it unset.
LLM_API_KEY=
LLM_EXTRACT_MODEL=openai/gpt-oss-120b
LLM_INTENT_MODEL=openai/gpt-oss-20b
# Registered intent-classifier prompt version.
LLM_INTENT_PROMPT_VERSION=v1
LLM_TIMEOUT_SECONDS=10
# Telegram voice-note transcription (Groq Whisper by default).
STT_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_MODEL=whisper-large-v3-turbo
STT_TIMEOUT_SECONDS=30
# Optional semantic-memory indexing. Disabled keeps durable lexical memory
# behavior and marks new facts pending until a provider is configured/backfilled.
EMBEDDING_PROVIDER=gemini
EMBEDDING_BASE_URL=https://api.openai.com/v1
# Used only when EMBEDDING_PROVIDER=gemini. The API adapter calls
# models/gemini-embedding-001:embedContent with the Google task type.
EMBEDDING_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_GEMINI_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=1536
EMBEDDING_TIMEOUT_SECONDS=10
# Default Telegram/backfill policy. Authenticated Vapi memory operations
# explicitly allow sensitive embedding and voice disclosure.
EMBEDDING_ALLOW_SENSITIVE_EXTERNAL=true
MEMORY_LEXICAL_CANDIDATE_LIMIT=20
MEMORY_SEMANTIC_CANDIDATE_LIMIT=3
# Offline calibration only; runtime similarity ranks candidates and does not
# reject them before GPT-OSS answer evaluation.
MEMORY_SEMANTIC_RELEVANCE_THRESHOLD=0.68
MEMORY_SEMANTIC_AMBIGUITY_MARGIN=0.04
# Time before an unanswered clarification is discarded.
CONVERSATION_SESSION_TTL_SECONDS=900
# Optional deployment fallback. Users with local-format contacts can set their
# own region with /phone_region XX; do not set this to a user-specific country
# in a multi-country deployment.
PHONE_DEFAULT_REGION=
LOG_LEVEL=INFO
LOG_FORMAT=text
# Colorized severity/event logs for interactive consoles. JSON logs never use color.
LOG_COLOR=true
LOG_INCLUDE_TRACEBACK=false
